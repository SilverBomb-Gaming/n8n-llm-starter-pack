              "name": "phone",
              "value": "={{ $json.phone }}",
              "type": "string"
            },
            {
              "id": "77330abe-9cf2-46e8-88b5-11ae7766237f",
              "name": "interest",
              "value": "={{ $json.interest }}",
              "type": "string"
            },
            {
              "id": "1d9f7cdb-d128-4262-90ac-c923087177bd",
              "name": "source",
              "value": "={{ $json.source || $('Lead Capture Form').item.json.Source }}",
