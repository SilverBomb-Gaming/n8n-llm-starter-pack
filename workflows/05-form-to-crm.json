            },
            {
              "id": "f92b119e-4a26-4e4d-8112-09c129140a49",
              "name": "email",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "c34fec59-9221-4616-83c0-d06a72a9df37",
