{
  "name": "05 \u00b7 Form to CRM (LLM)",
  "nodes": [
    {
      "parameters": {
        "content": "## 05 \u00b7 Form \u2192 CRM Stub\n\n**Demo (<10 min)**\n1. Import \u00b7 attach OpenAI credential\n2. Open Form test URL, submit sample lead\n3. *HTTP \u00b7 Upsert CRM Stub* posts to https://httpbin.org/post (safe public echo)\n4. Swap URL for HubSpot/Salesforce/Attio when ready\n\nShows LLM field normalization before a generic CRM/API write.",
        "height": 360,
        "width": 460,
        "color": 4
      },
      "id": "acc79dca-2f0f-412c-807e-78f3451a700f",
      "name": "Note \u2014 Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -320,
        40
      ]
    },
    {
      "parameters": {
        "formTitle": "Lead Capture",
        "formDescription": "Submit a messy lead. LLM normalizes fields, then we POST to a CRM/API stub.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Raw Details",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Jane D \u2014 acme corp, jane at acme.com, interested in enterprise plan, +1 555 0100"
            },
            {
              "fieldLabel": "Source",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "website / webinar / referral"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "383b3aac-1afd-418c-b17a-f8a819d6557d",
      "name": "Lead Capture Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        280
      ],
      "webhookId": "b6f6b963-0e5c-4dec-99c4-1a1a4c6c7523"
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Normalize messy lead text into JSON only: {\"full_name\":\"\",\"email\":\"\",\"company\":\"\",\"phone\":\"\",\"interest\":\"\",\"source\":\"\",\"confidence\":0.0}. Use empty string when unknown. confidence 0-1."
            },
            {
              "role": "user",
              "content": "=Source hint: {{ $json.Source || 'unknown' }}\n\nRaw details:\n{{ $json['Raw Details'] || $json.Raw_Details || JSON.stringify($json) }}"
            }
          ]
        },
        "simplify": true,
        "jsonOutput": true,
        "options": {
          "temperature": 0.1,
          "maxTokens": 400
        }
      },
      "id": "4ba29fdb-e209-4c14-948a-3a498e872487",
      "name": "LLM Normalize Lead Fields",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        280,
        280
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      },
      "notes": "Map this to your OpenAI (or OpenAI-compatible) credential after import.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9e11d062-0a83-4028-a69e-d1e0d4febec1",
              "name": "full_name",
